{"subject":"ozbek-tili","questions":[{"id":"ozb-01","text":"\"Kitob\" so'zi qaysi so'z turkumiga kiradi?","options":["Ot","Sifat","Fe'l","Ravish"],"correct":0,"difficulty":"yengil"},{"id":"ozb-02","text":"\"Chiroyli\" so'zi qaysi so'z turkumiga mansub?","options":["Ot","Sifat","Son","Olmosh"],"correct":1,"difficulty":"yengil"},{"id":"ozb-03","text":"Ega va kesim gapning qaysi bo'laklari hisoblanadi?","options":["Ikkinchi darajali","Bosh bo'laklar","Aniqlovchi","Undalma"],"correct":1,"difficulty":"o'rta"},{"id":"ozb-04","text":"\"Kel-di-lar\" so'zida nechta qo'shimcha bor?","options":["1","2","3","0"],"correct":1,"difficulty":"qiyin"},{"id":"ozb-05","text":"Sinonim so'zlar qanday so'zlar?","options":["Ma'nosi qarama-qarshi so'zlar","Ma'nosi yaqin so'zlar","Talaffuzi bir xil so'zlar","Ko'p ma'noli so'zlar"],"correct":1,"difficulty":"o'rta"},{"id":"ozb-06","text":"\"Olma\" va \"nok\" so'zlari orasidagi munosabat qanday?","options":["Sinonim","Antonim","Umumiy-xususiy","Omonim"],"correct":2,"difficulty":"qiyin"},{"id":"ozb-07","text":"Fe'lning bo'lishsiz shakli qaysi qo'shimcha bilan yasaladi?","options":["-ma/-may","-gan","-moq","-ish"],"correct":0,"difficulty":"qiyin"},{"id":"ozb-08","text":"\"Kitoblar\" so'zida ko'plik qo'shimchasi qaysi?","options":["-lar","-ni","-ga","-dan"],"correct":0,"difficulty":"yengil"},{"id":"ozb-09","text":"Qo'shma gap deb qanday gapga aytiladi?","options":["Bir ega, bir kesimli gap","Ikki yoki undan ortiq sodda gapdan tuzilgan gap","Faqat undov so'zli gap","Faqat savol gap"],"correct":1,"difficulty":"qiyin"},{"id":"ozb-10","text":"\"Yoz\" so'zi necha ma'noli so'z (fe'l va fasl nomi sifatida)?","options":["Sinonim","Omonim","Antonim","Paronim"],"correct":1,"difficulty":"o'rta"}]}
